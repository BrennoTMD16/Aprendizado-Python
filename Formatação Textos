# valor:.2f Separa o valor em 2 casas decimais com o .

# Alterando a variavel várias vezes
email = " EMAIL_TESTE@gmail.com"
email = email.lower() # Deixa o texto em caixas baixas
email = email.strip() # Retira os espaços do texto
print(email)

# Tamanho do texto
tamanho = len(email)
print(tamanho)

# Posição
posicao_arroba = email.find("@")
print(posicao_arroba)

# Pedaços de texto
print(email[posicao_arroba])
print(email[0:posicao_arroba])
print(email[posicao_arroba:tamanho])

# Trocar pedaço do texto
novo_email = email.replace("gmail.com", "yahoo.com.br")
print(novo_email)

