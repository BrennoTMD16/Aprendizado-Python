cardapio = []

class Produto():
    def __init__(self, nome, valor=0):
        self.nome = nome
        self.valor = valor

    def postar(self):
        cardapio.append(self)

    def editar_valor(self, valor):
        self.valor = valor

    def editar_nome(self, nome):
        self.nome = nome


arroz = Produto("Arrz")
arroz.postar()
arroz.editar_valor(10)
arroz.editar_nome("Arroz")

print(arroz.nome)
print(arroz.valor)
print(cardapio)
