cardapio = []

class Produto():
    def __init__(self, nome, valor=0):
        self.nome = nome
        self.valor = valor

    def postar(self):
        for produto in cardapio:
            if produto.nome == self.nome:
                print("Já existe um produto desse postado")
                return
            
        cardapio.append(self)

    def deletar(self):
        cardapio.remove(self)

    def editar_valor(self, valor):
        self.valor = valor

    def editar_nome(self, nome):
        for produto in cardapio:
            if produto.nome == nome:
                print("Já existe um produto com esse nome")
                return
        self.nome = nome


arroz = Produto("Arrz")
arroz.postar()
arroz.editar_valor(10)
arroz.editar_nome("Arroz")

feijao = Produto("Feijao", 8)
feijao.postar()
feijao.editar_nome("Arroz")

print(arroz.nome)
print(arroz.valor)
print(cardapio)

arroz.deletar()
print(cardapio)
